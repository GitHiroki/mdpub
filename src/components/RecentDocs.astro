---
import { getCollection } from 'astro:content';
import { Badge } from '@astrojs/starlight/components';

// mdpub-deploy が付け替える sidebar.badge を新着の判定に使う。
// 配列の順がそのまま表示順になる。
const NEW_BADGES = ['新規', '更新'];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const recent = (await getCollection('docs'))
    .filter((entry) => entry.id !== 'index')
    .map((entry) => {
        const badge = entry.data.sidebar?.badge;
        return {
            entry,
            text: typeof badge === 'string' ? badge : badge?.text,
            variant: typeof badge === 'string' ? 'default' : (badge?.variant ?? 'default'),
        };
    })
    .filter(({ text }) => text !== undefined && NEW_BADGES.includes(text))
    .sort((a, b) => {
        const byBadge = NEW_BADGES.indexOf(a.text) - NEW_BADGES.indexOf(b.text);
        if (byBadge !== 0) return byBadge;
        return a.entry.data.title.localeCompare(b.entry.data.title, 'ja');
    });
---

<h2 id="recent">新着メモ</h2>

{
    recent.length === 0 ? (
        <p>いまのところ新着はありません。サイドバーから過去のメモをどうぞ。</p>
    ) : (
        <ul class="recent-docs">
            {recent.map(({ entry, text, variant }) => (
                <li class="recent-docs__item">
                    <a class="recent-docs__link" href={`${base}/${entry.id}/`}>
                        {entry.data.title}
                    </a>
                    <Badge text={text} variant={variant} size="small" />
                    {entry.data.description && <p class="recent-docs__description">{entry.data.description}</p>}
                </li>
            ))}
        </ul>
    )
}

<style>
    .recent-docs {
        list-style: none;
        padding: 0;
        margin-top: 1rem;
    }

    .recent-docs__item + .recent-docs__item {
        margin-top: 1rem;
        border-top: 1px solid var(--sl-color-gray-5);
        padding-top: 1rem;
    }

    .recent-docs__link {
        font-weight: 600;
        margin-inline-end: 0.5rem;
    }

    .recent-docs__description {
        margin-top: 0.25rem;
        color: var(--sl-color-gray-3);
        font-size: var(--sl-text-sm);
    }
</style>
